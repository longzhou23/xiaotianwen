# Copy to the deployment host as .env and fill values there.
# Do not commit the filled file.

ASTRBOT_HOME=/opt/xiaotianwen/instance/astrobot
ASTRBOT_DATA=/opt/xiaotianwen/instance/astrobot-data
SNOWLUMA_DATA=/opt/xiaotianwen/instance/snowluma-data

# Provider identifiers are not secrets; API keys are injected separately.
LLM_PROVIDER_ID=
VISION_PROVIDER_ID=
EMBEDDING_PROVIDER_ID=

# Secret values must be supplied by the host secret manager or a local secret file.
OPENAI_API_KEY=
SILICONFLOW_API_KEY=
ASTROMETRY_API_KEY=
ANTIPROMPTINJECTOR_WEBUI_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
