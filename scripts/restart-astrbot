#!/usr/bin/env bash
set -euo pipefail
SCRIPT_NAME=restart-astrbot
source "$(dirname "$0")/common.sh"

usage() {
  cat <<'EOF'
Usage: bin/restart-astrbot

Restart AstrBot only and wait for ports 6200 and 8001 to become ready.
SnowLuma and NapCat are not touched.
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  '')
    ;;
  *)
    die "this command does not accept arguments; use --help for usage"
    ;;
esac

ensure_runtime_dirs
acquire_maintenance_lock
clear_proxy_env

stop_astrbot
start_astrbot

log "AstrBot restart completed (PID $(<"$ASTROBOT_PID_FILE"))"
