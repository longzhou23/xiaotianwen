# Host-only secrets. Copy this file to
# ${PROJECT_ROOT}/.host-secrets/secrets.env and chmod 600 it.
# Never commit the populated file.

# Generated automatically by bootstrap when both values are absent. They must
# always be identical.
SECRET_WS_REVERSE_TOKEN=
SECRET_ACCESSTOKEN=

# Active model providers. Leave unused providers empty.
SECRET_DEEPSEEK_API_KEY=
SECRET_SILICONFLOW_API_KEY=
SECRET_OPENAI_API_KEY=
SECRET_TAVILY_API_KEY=

# Plugin credentials.
SECRET_ASTROMETRY_API_KEY=
ANTIPROMPTINJECTOR_WEBUI_TOKEN=

# Optional integrations.
SECRET_MOONSHOTAI_API_KEY=
SECRET_SHIPYARD_ACCESS_TOKEN=
SECRET_SHIPYARD_NEO_ACCESS_TOKEN=
SECRET_CUA_API_KEY=
